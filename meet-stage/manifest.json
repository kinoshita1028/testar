{
  "manifest_version": 3,
  "name": "Meet Stage - 画面共有コントローラー",
  "short_name": "Meet Stage",
  "version": "0.3.1",
  "description": "Google Meetでお客様に見せる画面を、操作用の別ウィンドウからワンクリックで切り替えます。",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://meet.google.com/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Meet Stage を開く" },
  "content_scripts": [
    { "matches": ["https://meet.google.com/*"], "js": ["inject.js"], "run_at": "document_start", "world": "MAIN" },
    { "matches": ["https://meet.google.com/*"], "js": ["content.js"], "run_at": "document_start" }
  ],
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
